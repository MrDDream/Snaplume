<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Snaplume.Ui"
        x:Class="Snaplume.Recording.RecordingControlBar"
        Title="{l:T Recording.Title}" WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        CanResize="False" SizeToContent="WidthAndHeight" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" FlowDirection="LeftToRight">
    <Window.Styles>
        <Style Selector="Button.bar">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
        <Style Selector="Button.bar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4A4A4A" />
        </Style>
        <Style Selector="Button.bar:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.bar:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </Window.Styles>

    <Border Background="#F01F1F1F" BorderBrush="#4B4B4B" BorderThickness="1" CornerRadius="10" Padding="10,5"
            PointerPressed="OnDrag" ToolTip.Tip="{l:T Recording.DragTip}">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="RecordDot" Width="12" Height="12" Fill="#E53935" VerticalAlignment="Center" />
            <TextBlock x:Name="TimeText" Text="00:00" Foreground="White" FontSize="16" FontWeight="SemiBold"
                       MinWidth="120" Margin="8,0,10,0" VerticalAlignment="Center" />
            <Button x:Name="PauseButton" Classes="bar" Click="OnPause" ToolTip.Tip="{l:T Recording.Pause}" IsEnabled="False">
                <Path x:Name="PauseIcon" Stroke="White" Fill="White" StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="24" Height="24" Stretch="None">
                    <Path.RenderTransform>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                    </Path.RenderTransform>
                </Path>
            </Button>
            <Button x:Name="StopButton" Classes="bar" Click="OnStop" ToolTip.Tip="{l:T Recording.StopTip}">
                <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2" Fill="#E53935" />
            </Button>
            <Button x:Name="CancelButton" Classes="bar" Click="OnCancel" ToolTip.Tip="{l:T Recording.CancelTip}">
                <Path Classes="icon" Data="{StaticResource IconClose}" Stroke="White" />
            </Button>
        </StackPanel>
    </Border>
</Window>
