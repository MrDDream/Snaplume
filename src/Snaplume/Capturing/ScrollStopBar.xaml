<Window x:Class="Snaplume.Capturing.ScrollStopBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Snaplume.Core"
        Title="{l:T Scroll.BarTitle}" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True">
    <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="12,7,8,7">
        <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconScroll}" Stroke="{DynamicResource AccentBrush}" />
            <StackPanel Margin="8,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{l:T Scroll.Running}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="DetailText" Text="{l:T Scroll.StopHintZone}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <Button Style="{StaticResource AccentButton}" Click="OnStop" ToolTip="{l:T Scroll.StopTip}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconStop}" Stroke="{DynamicResource OnAccentBrush}" />
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Scroll.Stop}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
