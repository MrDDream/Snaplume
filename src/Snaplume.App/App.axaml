<!--
  The application lives in the notification area: windows are opened from the tray icon, the global shortcuts and
  the command line (see App.axaml.cs). The theme variant (light / dark) is set at startup from the settings.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Snaplume.App"
             Name="Snaplume"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Snaplume/Themes/Colors.axaml" />
                <ResourceInclude Source="avares://Snaplume/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Capture gallery layout (the quick panel uses smaller items) -->
            <x:Double x:Key="GalleryItemWidth">200</x:Double>
            <x:Double x:Key="GalleryThumbnailHeight">130</x:Double>
            <TextAlignment x:Key="GalleryTextAlignment">Left</TextAlignment>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Snaplume/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
