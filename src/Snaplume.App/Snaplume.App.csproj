<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The application (Avalonia interface), for Windows and Linux:
      net10.0-windows10.0.19041.0  Windows build, with Snaplume.Platform.Windows (Win32, WinRT, ScreenRecorderLib)
      net10.0                      Linux build, with Snaplume.Platform.Linux (X11, Wayland portals, GStreamer...)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <AssemblyName>Snaplume</AssemblyName>
    <RootNamespace>Snaplume</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Logiciel libre de capture d'écran et d'annotation, sans service en ligne.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <!-- 20H1 minimum: excluding windows from captures (SetWindowDisplayAffinity) needs it. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ScreenRecorderLib is x64 only. -->
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);SNAPLUME_WINDOWS</DefineConstants>
  </PropertyGroup>

  <!--
    Trimmed publish (build/build-release.ps1 and build-linux.ps1 pass PublishTrimmed=true): only the assemblies marked
    trimmable (the .NET libraries, Avalonia, SkiaSharp, the Windows SDK projection...) lose what is never called;
    Snaplume's own assemblies and the others (ScreenRecorderLib, ZXing...) are kept whole, so the settings, annotations
    and presets keep being read and written by System.Text.Json's reflection on their types, as before. The trimmed
    libraries lose their precompiled code: trimming goes with ReadyToRun, or startup is twice as slow.
  -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- [ComImport] interfaces (shell thumbnails of videos) need the built-in COM interop, off by default when trimming. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snaplume.Core\Snaplume.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="..\Snaplume.Platform.Windows\Snaplume.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\Snaplume.Platform.Linux\Snaplume.Platform.Linux.csproj" />
  </ItemGroup>

</Project>
