<UserControl x:Class="Snaplume.Workspace.CaptureGallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Snaplume.Core">
    <!-- Colors come from the "Gallery*" theme brushes; sizes from the "Gallery*" resources, smaller in the quick panel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        <Style x:Key="CaptureItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GalleryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GallerySelectedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GallerySelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ListBox x:Name="CaptureList" SelectionMode="Extended" BorderThickness="0" Padding="6"
                 Background="{DynamicResource GalleryBackgroundBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource CaptureItemStyle}"
                 AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" Drop="OnDrop"
                 MouseDoubleClick="OnItemDoubleClick" KeyDown="OnListKeyDown"
                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown" PreviewMouseMove="OnListPreviewMouseMove"
                 PreviewMouseLeftButtonUp="OnListPreviewMouseUp"
                 ContextMenuOpening="OnListContextMenuOpening"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="{DynamicResource GalleryItemWidth}" Margin="8">
                        <Border Height="{DynamicResource GalleryThumbnailHeight}" Background="{DynamicResource GalleryThumbnailBrush}"
                                BorderBrush="{DynamicResource GalleryThumbnailBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <!-- Screenshots are never mirrored, even right-to-left -->
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"
                                       FlowDirection="LeftToRight" />
                                <!-- Play badge on videos -->
                                <Border Visibility="{Binding IsVideo, Converter={StaticResource VisibleIfTrue}}"
                                        Width="34" Height="34" CornerRadius="17" Background="{DynamicResource GalleryBadgeBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                    <Path Data="M13,10 L25,17 L13,24 Z" Fill="{DynamicResource GalleryBadgeIconBrush}" Width="34" Height="34" Stretch="None" />
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" FontWeight="SemiBold"
                                   TextAlignment="{DynamicResource GalleryTextAlignment}"
                                   Foreground="{DynamicResource GalleryTextBrush}" ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   TextAlignment="{DynamicResource GalleryTextAlignment}"
                                   Foreground="{DynamicResource GalleryMutedTextBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{l:T Gallery.Menu.Edit}" Click="OnEdit" InputGestureText="{l:T Gallery.Menu.EditKey}" FontWeight="SemiBold" />
                    <MenuItem Header="{l:T Gallery.Menu.Copy}" Click="OnCopy" InputGestureText="Ctrl+C" />
                    <MenuItem Header="{l:T Gallery.Menu.CopyPath}" Click="OnCopyPath" />
                    <MenuItem Header="{l:T Ocr.ReadText}" Click="OnReadText" />
                    <Separator />
                    <MenuItem Header="{l:T Gallery.Menu.OpenDefault}" Click="OnOpenDefault" />
                    <MenuItem Header="{l:T Gallery.Menu.ShowInExplorer}" Click="OnShowInExplorer" />
                    <Separator />
                    <!-- Filled with the other workspaces when the menu opens -->
                    <MenuItem x:Name="MoveToMenu" Header="{l:T Gallery.Menu.MoveTo}" />
                    <MenuItem Header="{l:T Gallery.Menu.Rename}" Click="OnRename" InputGestureText="F2" />
                    <MenuItem Header="{l:T Gallery.Menu.Delete}" Click="OnDelete" InputGestureText="{l:T Gallery.Menu.DeleteKey}" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="16"
                    Visibility="Collapsed">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconRegion}" Stroke="{DynamicResource GalleryMutedTextBrush}" HorizontalAlignment="Center">
                <Path.LayoutTransform>
                    <ScaleTransform ScaleX="2.5" ScaleY="2.5" />
                </Path.LayoutTransform>
            </Path>
            <TextBlock x:Name="EmptyTitle" Text="{l:T Gallery.Empty}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource GalleryTextBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,4" />
            <TextBlock x:Name="EmptyHintText" Foreground="{DynamicResource GalleryMutedTextBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
