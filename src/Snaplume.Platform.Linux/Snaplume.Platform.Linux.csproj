<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Linux services (see Snaplume.Core/Platform/IPlatform.cs). X11: libX11/XTest/XRandR/XInput2 through P/Invoke.
    Wayland: xdg-desktop-portal over D-Bus (Screenshot, ScreenCast, RemoteDesktop, GlobalShortcuts).
    External programs, declared as package dependencies: GStreamer (recording, playback), ffmpeg (cutting,
    GIF frames, thumbnails), Tesseract (OCR), gio (trash), xdg-email, CUPS lp (printing).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Snaplume.Platform.Linux</RootNamespace>
    <AssemblyName>Snaplume.Platform.Linux</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <!-- D-Bus (MIT): portals, notifications, file manager. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snaplume.Core\Snaplume.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snaplume.Tests" />
    <!-- Notification-area icon, rendered from docs/branding/snaplume.svg by packaging/linux/icongen. -->
    <EmbeddedResource Include="Assets\tray.png" LogicalName="Snaplume.Platform.Linux.tray.png" />
  </ItemGroup>

</Project>
