<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Snaplume.Ui"
        x:Class="Snaplume.Player.WebExportDialog"
        Title="{l:T Player.Web.Title}" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>
    <StackPanel Margin="20,16,20,18">
        <TextBlock Classes="label" Text="{l:T Player.Export.Range}" />
        <ComboBox x:Name="RangeBox" HorizontalAlignment="Stretch" Margin="0,0,0,12" />

        <TextBlock Classes="label" Text="{l:T Player.Web.Format}" />
        <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch" />
        <TextBlock x:Name="FormatNote" Classes="note" Margin="0,4,0,12" />

        <!-- Without ffmpeg only MP4 H.264 is listed: the other formats come with the module, downloaded from here -->
        <StackPanel x:Name="MoreFormatsPanel" IsVisible="False" Margin="0,0,0,12">
            <Button x:Name="ModuleButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Padding="10,7" Click="OnModuleClick" ToolTip.Tip="{l:T Player.Web.ModuleTip}">
                <DockPanel>
                    <Path Classes="icon" Data="{StaticResource IconDownload}" Stroke="{DynamicResource AccentBrush}" Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="{l:T Player.Web.MoreFormats}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ModuleSizeText" Classes="note" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <!-- Download in progress: its own Cancel (the dialog stays open) -->
            <DockPanel x:Name="ModuleProgressPanel" IsVisible="False">
                <Button DockPanel.Dock="Right" Content="{l:T Common.Cancel}" Padding="10,3" Margin="10,0,0,0"
                        VerticalAlignment="Center" Click="OnCancelModule" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ModuleStatus" Classes="note" />
                    <ProgressBar x:Name="ModuleProgress" Classes="thin" Minimum="0" Maximum="1" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
            <!-- Linux: the system's package -->
            <TextBlock x:Name="ModuleNote" Classes="note" IsVisible="False" />
            <!-- Windows: why the download or the installation failed -->
            <TextBlock x:Name="ModuleError" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="False" />
        </StackPanel>

        <TextBlock Classes="label" Text="{l:T Player.Web.Target}" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <ComboBox x:Name="TargetBox" HorizontalAlignment="Stretch" />
            <StackPanel x:Name="MegabytesPanel" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                <TextBox x:Name="MegabytesBox" Width="76" HorizontalContentAlignment="Right" />
                <TextBlock Text="{l:T Player.Web.Megabytes}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="QualityPanel" Margin="0,0,0,12">
            <TextBlock Classes="label" Text="{l:T Player.Web.Quality}" />
            <ComboBox x:Name="QualityBox" HorizontalAlignment="Stretch" />
        </StackPanel>

        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,8,0,0" IsVisible="False" TextWrapping="Wrap" />


        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="8">
            <Button Classes="accent" Content="{l:T Player.Export.Ok}" IsDefault="True" Padding="14,4" Click="OnOk" />
            <Button Content="{l:T Common.Cancel}" IsCancel="True" Padding="14,4" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
