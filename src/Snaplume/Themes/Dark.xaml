<!-- Dark theme colors. Same keys as Light.xaml; ThemeManager swaps the two, so use them with DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#262626" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="CardBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#383838" />
    <SolidColorBrush x:Key="RowLineBrush" Color="#343434" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#161616" />
    <SolidColorBrush x:Key="PopupBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="TileBrush" Color="#363636" />

    <!-- Text and lines -->
    <SolidColorBrush x:Key="TextBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="IconBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="LineBrush" Color="#404040" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#F87171" />

    <!-- States -->
    <SolidColorBrush x:Key="HoverBrush" Color="#383838" />
    <SolidColorBrush x:Key="PressedBrush" Color="#454545" />
    <SolidColorBrush x:Key="CheckedBrush" Color="#3B2A5E" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#303030" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#3A3A3A" />

    <!-- Accent: the violet of the logo, lighter to stay readable on dark -->
    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6D28D9" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnAccentLineBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="RecordBrush" Color="#EF5350" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#4B4B4B" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="SwitchTrackBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SwitchBorderBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="SwitchKnobBrush" Color="#D1D5DB" />

    <!-- Notices -->
    <SolidColorBrush x:Key="WarningBrush" Color="#33290F" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#B7791F" />

    <!-- Quick panel -->
    <SolidColorBrush x:Key="PanelBrush" Color="#202020" />
    <SolidColorBrush x:Key="PanelChromeBrush" Color="#191919" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SecondaryActionBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#0D000000" />

    <!-- Workspace list: an entry where dragged captures will be dropped -->
    <SolidColorBrush x:Key="DropTargetBrush" Color="#3B2A5E" />

    <!-- Editor color swatches -->
    <SolidColorBrush x:Key="SwatchOutlineBrush" Color="#6B7280" />

    <!-- Capture gallery -->
    <SolidColorBrush x:Key="GalleryBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="GalleryTextBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="GalleryMutedTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="GalleryHoverBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="GallerySelectedBrush" Color="#33264F" />
    <SolidColorBrush x:Key="GallerySelectedBorderBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="GalleryThumbnailBrush" Color="#161616" />
    <SolidColorBrush x:Key="GalleryThumbnailBorderBrush" Color="#383838" />
    <SolidColorBrush x:Key="GalleryBadgeBrush" Color="#B0000000" />
    <SolidColorBrush x:Key="GalleryBadgeIconBrush" Color="#FFFFFF" />

    <!-- Video player: stays dark in both themes, like a cinema screen (mpv style) -->
    <SolidColorBrush x:Key="PlayerBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="PlayerTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PlayerHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="PlayerTrackBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="PlayerAccentBrush" Color="#EF5350" />
    <SolidColorBrush x:Key="PlayerOsdBrush" Color="#A0000000" />
    <LinearGradientBrush x:Key="PlayerControllerBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#D0000000" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
