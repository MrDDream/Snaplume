<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Snaplume.Ui"
        x:Class="Snaplume.Player.GifExportDialog"
        Title="{l:T Player.Gif.Title}" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Styles>
    <StackPanel Margin="20,16,20,18">
        <TextBlock Classes="label" Text="{l:T Player.Gif.Range}" />
        <ComboBox x:Name="RangeBox" HorizontalAlignment="Stretch" Margin="0,0,0,12" />

        <Grid ColumnDefinitions="*,16,*" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Classes="label" Text="{l:T Player.Gif.FramesPerSecond}" />
                <TextBox x:Name="FpsBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Classes="label" Text="{l:T Player.Gif.Speed}" />
                <ComboBox x:Name="SpeedBox" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <TextBlock Classes="label" Text="{l:T Player.Gif.Width}" />
        <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="HeightText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                       Margin="10,0,0,0" MinWidth="120" />
            <TextBox x:Name="WidthBox" />
        </DockPanel>

        <CheckBox x:Name="LoopCheck" Content="{l:T Player.Gif.Loop}" IsChecked="True" Margin="0,0,0,6" />
        <CheckBox x:Name="DitherCheck" Content="{l:T Player.Gif.Dither}" />

        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,8,0,0" IsVisible="False" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="8">
            <Button Classes="accent" Content="{l:T Player.Gif.Export}" IsDefault="True" Padding="14,4" Click="OnOk" />
            <Button Content="{l:T Common.Cancel}" IsCancel="True" Padding="14,4" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
