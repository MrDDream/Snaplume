<Project>
  <!-- Settings shared by every project of the solution. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.2.0</Version>
    <Product>Snaplume</Product>
    <Copyright>Contributeurs Snaplume — licence MIT</Copyright>
    <!-- Avalonia's build telemetry: Snaplume sends nothing anywhere, its build neither. -->
    <AvaloniaTelemetryOptOut>true</AvaloniaTelemetryOptOut>
    <!--
      Snaplume.App also targets Windows: restoring it on Linux (tests, Linux packages) needs the Windows targeting
      packs. Only the net10.0 build is compiled there.
    -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <!--
    Trimmed publish (see Snaplume.App.csproj): the trim analysis warns about every System.Text.Json call of Snaplume's
    own assemblies, which are not trimmed, so nothing it says applies.
  -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!-- One version of each package for the whole solution. -->
  <PropertyGroup>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <!-- The SkiaSharp version Avalonia is built with. -->
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
  </PropertyGroup>
</Project>
