<Window x:Class="Snaplume.Player.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Snaplume.Core"
        Title="{l:T Player.Title}" Width="1100" Height="680" MinWidth="620" MinHeight="300"
        Icon="pack://application:,,,/Assets/app.ico" Background="{DynamicResource PlayerBackgroundBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Colors: the Player* brushes of the themes (the player stays dark in both, like mpv) -->

        <Style x:Key="PlayerButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayerHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Stroke" Value="{DynamicResource PlayerTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.9" />
        </Style>

        <!-- Thin seek / volume bar: accent fill, round thumb, click to jump -->
        <Style x:Key="PlayerSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource PlayerTrackBrush}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource PlayerAccentBrush}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource PlayerTextBrush}" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Width" Value="15" />
                                                        <Setter TargetName="Knob" Property="Height" Value="15" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Geometry x:Key="PlayGeometry">M8,5 L19,12 L8,19 Z</Geometry>
        <Geometry x:Key="PauseGeometry">M8,5 H10.5 V19 H8 Z M13.5,5 H16 V19 H13.5 Z</Geometry>
        <Geometry x:Key="VolumeGeometry">M4,9 H8 L13,5 V19 L8,15 H4 Z M16,9 A4,4 0 0 1 16,15 M18.5,6.5 A7.5,7.5 0 0 1 18.5,17.5</Geometry>
        <Geometry x:Key="MutedGeometry">M4,9 H8 L13,5 V19 L8,15 H4 Z M16,9.5 L21,14.5 M21,9.5 L16,14.5</Geometry>
        <Geometry x:Key="LoopGeometry">M4,12 V10 A3,3 0 0 1 7,7 H18 M15,4 L18,7 L15,10 M20,12 V14 A3,3 0 0 1 17,17 H6 M9,20 L6,17 L9,14</Geometry>
        <Geometry x:Key="FullscreenGeometry">M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15</Geometry>
        <Geometry x:Key="FrameGeometry">M3,8 H7 L9,5 H15 L17,8 H21 V19 H3 Z M12,10 A3.5,3.5 0 1 1 11.99,10 Z</Geometry>
        <!-- Extract: start bracket then a play arrow, arrow then end bracket -->
        <Geometry x:Key="InGeometry">M10,5 H6 V19 H10 M13,8.5 L18,12 L13,15.5 Z</Geometry>
        <Geometry x:Key="OutGeometry">M14,5 H18 V19 H14 M6,8.5 L11,12 L6,15.5 Z</Geometry>
        <Geometry x:Key="ClearRangeGeometry">M7,7 L17,17 M17,7 L7,17</Geometry>
        <Geometry x:Key="ExportGeometry">M12,4 V14 M8,8 L12,4 L16,8 M5,13 V19 H19 V13</Geometry>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource PlayerBackgroundBrush}" MouseMove="OnMouseMove" MouseLeftButtonDown="OnVideoMouseDown" MouseWheel="OnMouseWheel">
        <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight" />

        <!-- On-screen messages, mpv style -->
        <Border x:Name="Osd" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="10,5"
                Background="{DynamicResource PlayerOsdBrush}" CornerRadius="4" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="OsdText" Foreground="{DynamicResource PlayerTextBrush}" FontSize="18" />
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource PlayerTextBrush}" FontSize="16" TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" Visibility="Collapsed" />

        <!-- Export in progress (extract or GIF): progress and cancel -->
        <Border x:Name="ExportPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18" Padding="14,10,8,10"
                Background="{DynamicResource PlayerOsdBrush}" CornerRadius="6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="240" VerticalAlignment="Center">
                    <TextBlock x:Name="ExportText" Foreground="{DynamicResource PlayerTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <Grid Height="4" Margin="0,8,0,0">
                        <Border Background="{DynamicResource PlayerTrackBrush}" CornerRadius="2" />
                        <Border x:Name="ExportBar" Background="{DynamicResource PlayerAccentBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ExportScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
                <Button Style="{StaticResource PlayerButton}" Margin="8,0,0,0" Click="OnCancelExportClick" ToolTip="{l:T Player.CancelExportTip}">
                    <Path Style="{StaticResource PlayerIcon}" Data="{StaticResource ClearRangeGeometry}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Controller (fades away when the mouse is idle) -->
        <Border x:Name="Controller" VerticalAlignment="Bottom" Padding="14,28,14,8" MouseEnter="OnControllerEnter" MouseLeave="OnControllerLeave"
                Background="{DynamicResource PlayerControllerBrush}">
            <StackPanel>
                <!-- Not mirrored right-to-left: time runs left to right, like the arrow keys -->
                <Grid FlowDirection="LeftToRight">
                    <!-- Extract (in → out points), drawn under the seek bar -->
                    <Canvas x:Name="RangeLayer" IsHitTestVisible="False" ClipToBounds="True">
                        <Border x:Name="RangeBand" Canvas.Top="5" Height="8" CornerRadius="2" Background="{DynamicResource PlayerTextBrush}"
                                Opacity="0.35" Visibility="Collapsed" />
                        <Rectangle x:Name="InMarker" Canvas.Top="1" Width="2" Height="16" Fill="{DynamicResource PlayerTextBrush}" Visibility="Collapsed" />
                        <Rectangle x:Name="OutMarker" Canvas.Top="1" Width="2" Height="16" Fill="{DynamicResource PlayerTextBrush}" Visibility="Collapsed" />
                    </Canvas>
                    <Slider x:Name="SeekBar" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1"
                            ValueChanged="OnSeekChanged" SizeChanged="OnSeekBarSizeChanged" ToolTip="{l:T Player.SeekTip}" />
                </Grid>
                <DockPanel Margin="0,4,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource PlayerButton}" Width="54" Click="OnSpeedClick"
                                ToolTip="{l:T Player.SpeedTip}">
                            <TextBlock x:Name="SpeedText" Text="1×" Foreground="{DynamicResource PlayerTextBrush}" FontSize="13" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" Click="OnMuteClick" ToolTip="{l:T Player.MuteTip}">
                            <Path x:Name="VolumeIcon" Style="{StaticResource PlayerIcon}" Data="{StaticResource VolumeGeometry}" />
                        </Button>
                        <Slider x:Name="VolumeBar" Style="{StaticResource PlayerSlider}" Width="90" Minimum="0" Maximum="1" Value="0.8"
                                ValueChanged="OnVolumeChanged" Margin="2,0,8,0" ToolTip="{l:T Player.VolumeTip}" />
                        <Button Style="{StaticResource PlayerButton}" Click="OnLoopClick" ToolTip="{l:T Player.LoopTip}">
                            <Path x:Name="LoopIcon" Style="{StaticResource PlayerIcon}" Data="{StaticResource LoopGeometry}" Opacity="0.5" />
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" Click="OnExportFrameClick" ToolTip="{l:T Player.ExportFrameTip}">
                            <Path Style="{StaticResource PlayerIcon}" Data="{StaticResource FrameGeometry}" />
                        </Button>
                        <Button x:Name="ExportButton" Style="{StaticResource PlayerButton}" Click="OnExportMenuClick" ToolTip="{l:T Player.ExportTip}">
                            <Path Style="{StaticResource PlayerIcon}" Data="{StaticResource ExportGeometry}" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="ExportClipItem" Header="{l:T Player.ExportClip}" InputGestureText="E" Click="OnExportClipClick" />
                                    <MenuItem x:Name="ExportGifItem" Header="{l:T Player.ExportGif}" InputGestureText="G" Click="OnExportGifClick" />
                                    <Separator />
                                    <MenuItem Header="{l:T Player.ExportFrame}" InputGestureText="S" Click="OnExportFrameClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" Click="OnFullscreenClick" ToolTip="{l:T Player.FullscreenTip}">
                            <Path Style="{StaticResource PlayerIcon}" Data="{StaticResource FullscreenGeometry}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PlayerButton}" Click="OnPlayClick" ToolTip="{l:T Player.PlayTip}">
                            <Path x:Name="PlayIcon" Data="{StaticResource PauseGeometry}" Fill="{DynamicResource PlayerTextBrush}" Width="24" Height="24" Stretch="None"
                                  FlowDirection="LeftToRight" />
                        </Button>
                        <TextBlock x:Name="TimeText" Foreground="{DynamicResource PlayerTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Text="00:00 / 00:00" />
                        <!-- Extract: in / out points -->
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource PlayerTrackBrush}" Margin="12,0,6,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PlayerButton}" Click="OnSetInClick" ToolTip="{l:T Player.SetInTip}">
                            <Path Style="{StaticResource PlayerIcon}" Data="{StaticResource InGeometry}" FlowDirection="LeftToRight" />
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" Click="OnSetOutClick" ToolTip="{l:T Player.SetOutTip}">
                            <Path Style="{StaticResource PlayerIcon}" Data="{StaticResource OutGeometry}" FlowDirection="LeftToRight" />
                        </Button>
                        <TextBlock x:Name="RangeText" Foreground="{DynamicResource PlayerTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Opacity="0.85" FlowDirection="LeftToRight" Visibility="Collapsed" />
                        <Button x:Name="ClearRangeButton" Style="{StaticResource PlayerButton}" Click="OnClearRangeClick" ToolTip="{l:T Player.ClearRangeTip}"
                                Visibility="Collapsed">
                            <Path Style="{StaticResource PlayerIcon}" Data="{StaticResource ClearRangeGeometry}" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
