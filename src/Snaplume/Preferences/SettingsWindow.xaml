<Window x:Class="Snaplume.Preferences.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Snaplume.Core"
        xmlns:local="clr-namespace:Snaplume.Preferences"
        Title="{l:T Settings.WindowTitle}" Width="880" Height="620" MinWidth="720" MinHeight="460"
        Icon="pack://application:,,,/Assets/app.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource SidebarBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <!-- On/off switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="{DynamicResource SwitchTrackBrush}"
                                    BorderBrush="{DynamicResource SwitchBorderBrush}" BorderThickness="1.5" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource SwitchKnobBrush}" HorizontalAlignment="Left" Margin="5,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <!-- One setting: title + description on the left, control on the right -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="BorderBrush" Value="{DynamicResource RowLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="LastRow" TargetType="Border" BasedOn="{StaticResource Row}">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="RowDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,16,0" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,4,0,8" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,5,26,5" />
        </Style>
        <Style TargetType="local:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="230" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="12,9">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Marker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{l:T Common.Cancel}" IsCancel="True" Style="{StaticResource FlatButton}" Padding="16,6" BorderBrush="{DynamicResource LineBrush}" Margin="0,0,8,0" />
                    <Button IsDefault="True" Style="{StaticResource AccentButton}" Padding="18,6" Click="OnOk">
                        <TextBlock Text="{l:T Common.Save}" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{l:T Settings.FooterHint}" />
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <Border DockPanel.Dock="Left" Width="220" Background="{DynamicResource SidebarBrush}" Padding="12,18,12,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="6,0,0,18">
                    <Image Source="{StaticResource LogoImage}" Width="26" Height="26" />
                    <TextBlock Text="{l:T Settings.Title}" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNavChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="PageGeneral">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" />
                            <TextBlock Text="{l:T Settings.Nav.General}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageCapture">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconRegion}" />
                            <TextBlock Text="{l:T Settings.Nav.Capture}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageVideo">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconVideo}" />
                            <TextBlock Text="{l:T Settings.Nav.Video}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageHotkeys">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="M3,7 H21 V17 H3 Z M6,10 H7 M10,10 H11 M14,10 H15 M18,10 H18.5 M7,14 H17" />
                            <TextBlock Text="{l:T Settings.Nav.Hotkeys}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageAbout">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="M12,3 A9,9 0 1 1 11.99,3 Z M12,11 V17 M12,7.5 V8" />
                            <TextBlock Text="{l:T Settings.Nav.About}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Pages -->
        <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}">
            <Grid Margin="30,22,30,20" MaxWidth="760" HorizontalAlignment="Left">

                <!-- General -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.General}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Settings.General.Subtitle}" />

                    <TextBlock Style="{StaticResource CardHeader}" Text="{l:T Settings.LanguageHeader}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="190" VerticalAlignment="Center" DisplayMemberPath="Name" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Language}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.LanguageDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="190" VerticalAlignment="Center" DisplayMemberPath="Name" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Theme}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.ThemeDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="{l:T Settings.General.SavingHeader}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.General.Folder}" />
                                    <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.General.FolderDescription}" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="{l:T Common.Open}" Style="{StaticResource FlatButton}" BorderBrush="{DynamicResource LineBrush}" Padding="12,4" Margin="6,0,0,0" Click="OnOpenFolder" />
                                        <Button DockPanel.Dock="Right" Content="{l:T Common.Browse}" Style="{StaticResource FlatButton}" BorderBrush="{DynamicResource LineBrush}" Padding="12,4" Margin="6,0,0,0" Click="OnBrowse" />
                                        <TextBox x:Name="FolderBox" Padding="6,5" VerticalContentAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBox x:Name="PrefixBox" DockPanel.Dock="Right" Width="170" Padding="6,5" VerticalAlignment="Center" TextChanged="OnPrefixChanged" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.General.FileNamePrefix}" />
                                        <TextBlock x:Name="PrefixExample" Style="{StaticResource RowDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <ComboBox x:Name="FormatBox" DockPanel.Dock="Right" SelectionChanged="OnPrefixChanged">
                                        <ComboBoxItem Content="{l:T Settings.General.FormatPng}" Tag="png" />
                                        <ComboBoxItem Content="{l:T Settings.General.FormatJpeg}" Tag="jpg" />
                                    </ComboBox>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.General.ImageFormat}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.General.ImageFormatDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="{l:T Settings.General.AfterCaptureHeader}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="EditorCheck" Style="{StaticResource Switch}" DockPanel.Dock="Right" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.General.OpenEditor}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.General.OpenEditorDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="ClipboardCheck" Style="{StaticResource Switch}" DockPanel.Dock="Right" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.General.CopyToClipboard}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.General.CopyToClipboardDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <CheckBox x:Name="WorkspaceCheck" Style="{StaticResource Switch}" DockPanel.Dock="Right" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.General.ShowPanel}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.General.ShowPanelDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="{l:T Settings.General.SystemHeader}" />
                    <Border Style="{StaticResource Card}">
                        <Border Style="{StaticResource LastRow}">
                            <DockPanel>
                                <CheckBox x:Name="StartupCheck" Style="{StaticResource Switch}" DockPanel.Dock="Right" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.General.StartWithWindows}" />
                                    <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.General.StartWithWindowsDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- Capture -->
                <StackPanel x:Name="PageCapture" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.Capture}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Settings.Capture.Subtitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="CursorCheck" Style="{StaticResource Switch}" DockPanel.Dock="Right" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Capture.IncludeCursor}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.Capture.IncludeCursorDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <ComboBox x:Name="DelayBox" DockPanel.Dock="Right" DisplayMemberPath="Name" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Capture.Delay}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.Capture.DelayDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel Margin="18,13">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Capture.SelectionHelpTitle}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource RowDescription}" Margin="0,6,0,0"
                                       Text="{l:T Settings.Capture.SelectionHelp}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Video -->
                <StackPanel x:Name="PageVideo" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.Video}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Settings.Video.Subtitle}" />
                    <TextBlock Style="{StaticResource CardHeader}" Text="{l:T Settings.Video.SoundHeader}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="SystemAudioCheck" Style="{StaticResource Switch}" DockPanel.Dock="Right" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Video.SystemAudio}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.Video.SystemAudioDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <CheckBox x:Name="MicrophoneCheck" Style="{StaticResource Switch}" DockPanel.Dock="Right" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Video.Microphone}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.Video.MicrophoneDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource CardHeader}" Text="{l:T Settings.Video.ImageHeader}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="ClicksCheck" Style="{StaticResource Switch}" DockPanel.Dock="Right" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Video.ShowClicks}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.Video.ShowClicksDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <ComboBox x:Name="FramerateBox" DockPanel.Dock="Right" DisplayMemberPath="Name" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Video.Framerate}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.Video.FramerateDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource CardHeader}" Text="{l:T Settings.Video.WebcamHeader}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="WebcamCheck" Style="{StaticResource Switch}" DockPanel.Dock="Right" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Video.Webcam}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.Video.WebcamDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- Webcam options: only meaningful when the webcam is inlaid -->
                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=WebcamCheck}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Style="{StaticResource Row}">
                                    <DockPanel>
                                        <ComboBox x:Name="WebcamDeviceBox" DockPanel.Dock="Right" Width="230" DisplayMemberPath="Name" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Video.WebcamDevice}" />
                                            <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.Video.WebcamDeviceDescription}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Row}">
                                    <DockPanel>
                                        <ComboBox x:Name="WebcamCornerBox" DockPanel.Dock="Right" DisplayMemberPath="Name" />
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Video.WebcamCorner}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource LastRow}">
                                    <DockPanel>
                                        <ComboBox x:Name="WebcamSizeBox" DockPanel.Dock="Right" DisplayMemberPath="Name" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Video.WebcamSize}" />
                                            <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Settings.Video.WebcamSizeDescription}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Hotkeys -->
                <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.Hotkeys}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="{l:T Settings.Hotkeys.Subtitle}" />
                    <Border x:Name="SnippingWarning" Visibility="Collapsed" Background="{DynamicResource WarningBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{l:T Settings.Hotkeys.PrintScreenWarningTitle}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{l:T Settings.Hotkeys.PrintScreenWarningText}" />
                            <Button Content="{l:T Settings.Hotkeys.OpenKeyboardSettings}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Style="{StaticResource FlatButton}" BorderBrush="{DynamicResource WarningBorderBrush}" Padding="12,4" Click="OnOpenWindowsKeyboardSettings" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="RegionHotkey" DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Hotkeys.Region}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="ScreenHotkey" DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Hotkeys.Screen}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="WindowHotkey" DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Hotkeys.Window}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="RepeatHotkey" DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Hotkeys.Repeat}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="DelayedHotkey" DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Hotkeys.Delayed}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="VideoHotkey" DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Settings.Hotkeys.Video}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="TextHotkey" DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Ocr.CaptureText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.About}" />
                    <Border Style="{StaticResource Card}" Margin="0,10,0,14">
                        <StackPanel Margin="18,16">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource LogoImage}" Width="56" Height="56" />
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Snaplume" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,14,0,0"
                                       Text="{l:T Settings.About.Description}" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="{l:T Settings.About.SettingsFolder}" Style="{StaticResource FlatButton}" BorderBrush="{DynamicResource LineBrush}" Padding="12,4" Margin="0,0,8,0" Click="OnOpenSettingsFolder" />
                                <Button Content="{l:T Settings.About.ErrorLog}" Style="{StaticResource FlatButton}" BorderBrush="{DynamicResource LineBrush}" Padding="12,4" Click="OnOpenErrorLog" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource CardHeader}" Text="{l:T Update.Header}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{l:T Update.CheckNow}"
                                            Style="{StaticResource FlatButton}" BorderBrush="{DynamicResource LineBrush}" Padding="12,4" Click="OnCheckUpdates" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Update.Title}" />
                                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource RowDescription}" Text="{l:T Update.NotChecked}" />
                                        <Button x:Name="OpenUpdateButton" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Content="{l:T Update.Open}" Style="{StaticResource AccentButton}" Padding="12,4" Click="OnOpenUpdate" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <DockPanel>
                                    <CheckBox x:Name="AutoUpdateCheck" Style="{StaticResource Switch}" DockPanel.Dock="Right" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T Update.Auto}" />
                                        <TextBlock Style="{StaticResource RowDescription}" Text="{l:T Update.AutoDescription}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
