<!-- Full-size window: the workspaces (sub-folders) on the left, all the captures of the active one on the right. -->
<local:CaptureHostWindow xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:l="using:Snaplume.Ui"
                         xmlns:local="using:Snaplume.Workspace"
                         x:Class="Snaplume.Workspace.WorkspaceWindow"
                         Title="{l:T Workspace.Title}" Width="1020" Height="680" MinWidth="560" MinHeight="360"
                         Icon="/Assets/app.ico"
                         WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Styles>
        <!-- Sidebar button, content on the start side -->
        <Style Selector="Button.sidebar">
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="toolbar">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Classes="flat" Click="OnOpenFolder" ToolTip.Tip="{l:T Workspace.OpenFolderTipSystem}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconFolder}" />
                            <TextBlock Classes="button-label" Text="{l:T Workspace.Folder}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="flat" Click="OnSettings" ToolTip.Tip="{l:T Workspace.Settings}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconSettings}" />
                            <TextBlock Classes="button-label" Text="{l:T Workspace.Settings}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <WrapPanel>
                    <Button Classes="flat" Click="OnCaptureRegion" ToolTip.Tip="{l:T Workspace.CaptureTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconRegion}" />
                            <TextBlock Classes="button-label" Text="{l:T Workspace.Capture}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Classes="flat" Click="OnCaptureScreen" ToolTip.Tip="{l:T Workspace.ScreenTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconScreen}" />
                            <TextBlock Classes="button-label" Text="{l:T Workspace.Screen}" />
                        </StackPanel>
                    </Button>
                    <Button Name="VideoButton" Classes="flat" Click="OnRecordVideo" ToolTip.Tip="{l:T Workspace.VideoTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Name="VideoIcon" Classes="icon" Data="{StaticResource IconVideo}" />
                            <TextBlock Name="VideoButtonText" Classes="button-label" Text="{l:T Workspace.Video}" />
                        </StackPanel>
                    </Button>
                    <Button Name="DelayButton" Classes="flat" ToolTip.Tip="{l:T Workspace.DelayTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconTimer}" />
                            <TextBlock Classes="button-label">
                                <Run Text="{l:T Workspace.Delay}" /><Run Text=" ▾" />
                            </TextBlock>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{l:T Workspace.Delay3}" Tag="3" Click="OnDelayedCapture" />
                                <MenuItem Header="{l:T Workspace.Delay5}" Tag="5" Click="OnDelayedCapture" />
                                <MenuItem Header="{l:T Workspace.Delay10}" Tag="10" Click="OnDelayedCapture" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="flat" Click="OnCaptureText" ToolTip.Tip="{l:T Ocr.CaptureTextTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconOcr}" />
                            <TextBlock Classes="button-label" Text="{l:T Ocr.TextButton}" />
                        </StackPanel>
                    </Button>
                    <Button Name="ScrollingButton" Classes="flat" Click="OnCaptureScrolling" ToolTip.Tip="{l:T Workspace.ScrollingTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconScroll}" />
                            <TextBlock Classes="button-label" Text="{l:T Workspace.Scrolling}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="flat" Click="OnReadQr" ToolTip.Tip="{l:T Workspace.QrTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconQr}" />
                            <TextBlock Classes="button-label" Text="{l:T Workspace.Qr}" />
                        </StackPanel>
                    </Button>

                    <Rectangle Classes="toolbar-separator" />

                    <Button Name="EditButton" Classes="flat" Click="OnEdit" ToolTip.Tip="{l:T Workspace.EditTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconEdit}" />
                            <TextBlock Classes="button-label" Text="{l:T Workspace.Edit}" />
                        </StackPanel>
                    </Button>
                    <Button Name="CopyButton" Classes="flat" Click="OnCopy" ToolTip.Tip="{l:T Workspace.CopyTip}">
                        <Path Classes="icon" Data="{StaticResource IconCopy}" />
                    </Button>
                    <Button Name="DeleteButton" Classes="flat" Click="OnDelete" ToolTip.Tip="{l:T Workspace.DeleteTip}">
                        <Path Classes="icon" Data="{StaticResource IconDelete}" />
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="status-bar">
            <TextBlock Name="StatusText" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Workspaces (sub-folders), like Screenpresso -->
        <Border DockPanel.Dock="Left" Width="210" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:T Workspaces.Header}" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold"
                           Margin="18,12,12,6" />

                <!-- New workspace, and the commands of the active one -->
                <Grid DockPanel.Dock="Bottom" Margin="8,6,8,8" ColumnDefinitions="*,Auto">
                    <Button Classes="flat sidebar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnNewWorkspace"
                            ToolTip.Tip="{l:T Workspaces.NewTipFolder}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconAdd}" />
                            <TextBlock Classes="button-label" Text="{l:T Workspaces.New}" Margin="6,0,2,0" />
                        </StackPanel>
                    </Button>
                    <Button Name="WorkspaceMenuButton" Grid.Column="1" Classes="flat sidebar" Margin="2,0,0,0" Padding="9,6"
                            ToolTip.Tip="{l:T Workspaces.MoreTip}">
                        <TextBlock Text="▾" VerticalAlignment="Center" />
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuItem Name="RenameActiveItem" Header="{l:T Workspaces.Menu.Rename}" Click="OnRenameActive" />
                                <MenuItem Name="DeleteActiveItem" Header="{l:T Workspaces.Menu.Delete}" Click="OnDeleteActive" />
                                <MenuItem Name="ChangeFolderActiveItem" Header="{l:T Workspaces.Menu.ChangeFolder}" Click="OnChangeFolderActive" />
                                <MenuItem Name="DefaultFolderActiveItem" Header="{l:T Workspaces.Menu.DefaultFolder}" Click="OnDefaultFolderActive" />
                                <Separator />
                                <MenuItem Header="{l:T Workspaces.Menu.OpenFolder}" Click="OnOpenFolder" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <local:WorkspaceList Name="WorkspaceList" />
            </DockPanel>
        </Border>

        <local:CaptureGallery Name="Gallery" />
    </DockPanel>
</local:CaptureHostWindow>
