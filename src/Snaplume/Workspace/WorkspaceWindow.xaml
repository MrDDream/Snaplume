<local:CaptureHostWindow x:Class="Snaplume.Workspace.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Snaplume.Core"
        xmlns:local="clr-namespace:Snaplume.Workspace"
        Title="{l:T Workspace.Title}" Width="1020" Height="680" MinWidth="560" MinHeight="360"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <!-- One workspace of the sidebar: hover, active (accent marker) and drop target states -->
        <Style x:Key="WorkspaceItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="10,7">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Marker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DropTargetBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar button, content on the start side -->
        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Click="OnOpenFolder" ToolTip="{l:T Workspace.OpenFolderTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Workspace.Folder}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="OnSettings" ToolTip="{l:T Workspace.Settings}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconSettings}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Workspace.Settings}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource FlatButton}" Click="OnCaptureRegion" ToolTip="{l:T Workspace.CaptureTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconRegion}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Workspace.Capture}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="OnCaptureScreen" ToolTip="{l:T Workspace.ScreenTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconScreen}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Workspace.Screen}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="VideoButton" Style="{StaticResource FlatButton}" Click="OnRecordVideo" ToolTip="{l:T Workspace.VideoTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="VideoIcon" Style="{StaticResource Icon}" Data="{StaticResource IconVideo}" />
                            <TextBlock x:Name="VideoButtonText" Style="{StaticResource ButtonLabel}" Text="{l:T Workspace.Video}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DelayButton" Style="{StaticResource FlatButton}" Click="OnDelayMenu" ToolTip="{l:T Workspace.DelayTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconTimer}" />
                            <TextBlock Style="{StaticResource ButtonLabel}"><Run Text="{l:T Workspace.Delay}" /><Run Text=" ▾" /></TextBlock>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T Workspace.Delay3}" Tag="3" Click="OnDelayedCapture" />
                                <MenuItem Header="{l:T Workspace.Delay5}" Tag="5" Click="OnDelayedCapture" />
                                <MenuItem Header="{l:T Workspace.Delay10}" Tag="10" Click="OnDelayedCapture" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="OnCaptureText" ToolTip="{l:T Ocr.CaptureTextTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconOcr}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Ocr.TextButton}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="OnCaptureScrolling" ToolTip="{l:T Workspace.ScrollingTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconScroll}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Workspace.Scrolling}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="OnReadQr" ToolTip="{l:T Workspace.QrTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconQr}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Workspace.Qr}" />
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button x:Name="EditButton" Style="{StaticResource FlatButton}" Click="OnEdit" ToolTip="{l:T Workspace.EditTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconEdit}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Workspace.Edit}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyButton" Style="{StaticResource FlatButton}" Click="OnCopy" ToolTip="{l:T Workspace.CopyTip}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" />
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource FlatButton}" Click="OnDelete" ToolTip="{l:T Workspace.DeleteTip}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconDelete}" />
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}">
            <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Workspaces (sub-folders), like Screenpresso -->
        <Border DockPanel.Dock="Left" Width="210" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:T Workspaces.Header}" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold"
                           Margin="18,12,12,6" />

                <!-- New workspace, and the commands of the active one -->
                <Grid DockPanel.Dock="Bottom" Margin="8,6,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SidebarButton}" HorizontalContentAlignment="Left" Click="OnNewWorkspace"
                            ToolTip="{l:T Workspaces.NewTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconAdd}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Workspaces.New}" Margin="6,0,2,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="WorkspaceMenuButton" Grid.Column="1" Style="{StaticResource SidebarButton}" Margin="2,0,0,0" Padding="9,6"
                            Click="OnWorkspaceMenu" ToolTip="{l:T Workspaces.MoreTip}">
                        <TextBlock Text="▾" VerticalAlignment="Center" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="RenameActiveItem" Header="{l:T Workspaces.Menu.Rename}" Click="OnRenameActive" />
                                <MenuItem x:Name="DeleteActiveItem" Header="{l:T Workspaces.Menu.Delete}" Click="OnDeleteActive" />
                                <Separator />
                                <MenuItem Header="{l:T Workspaces.Menu.OpenFolder}" Click="OnOpenFolder" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <ListBox x:Name="WorkspaceList" Background="Transparent" BorderThickness="0" Padding="8,0"
                         ItemContainerStyle="{StaticResource WorkspaceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnWorkspaceSelected" ContextMenuOpening="OnWorkspaceContextMenuOpening"
                         AllowDrop="True" DragEnter="OnWorkspaceDragOver" DragOver="OnWorkspaceDragOver"
                         DragLeave="OnWorkspaceDragLeave" Drop="OnWorkspaceDrop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconWorkspace}" />
                                <TextBlock Text="{Binding DisplayName}" Margin="9,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RenameEntryItem" Header="{l:T Workspaces.Menu.Rename}" Click="OnRenameEntry" />
                            <MenuItem x:Name="DeleteEntryItem" Header="{l:T Workspaces.Menu.Delete}" Click="OnDeleteEntry" />
                            <MenuItem x:Name="OpenEntryItem" Header="{l:T Workspaces.Menu.OpenFolder}" Click="OnOpenEntryFolder" />
                            <Separator x:Name="EntrySeparator" />
                            <MenuItem Header="{l:T Workspaces.New}" Click="OnNewWorkspace" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <local:CaptureGallery x:Name="Gallery" />
    </DockPanel>
</local:CaptureHostWindow>
