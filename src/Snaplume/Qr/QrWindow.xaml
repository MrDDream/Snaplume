<Window x:Class="Snaplume.Qr.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Snaplume.Core"
        Title="{l:T Qr.Title}" Width="560" Height="420" MinWidth="360" MinHeight="240"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Padding="12,8">
            <DockPanel>
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconQr}" />
                <TextBlock x:Name="StatusText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,10">
            <Button Style="{StaticResource FlatButton}" Click="OnClose" HorizontalAlignment="Right" IsCancel="True">
                <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Qr.Close}" />
            </Button>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                <ItemsControl x:Name="CodeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource FlatButton}" Click="OnOpenLink" Visibility="{Binding LinkVisibility}"
                                                    ToolTip="{l:T Qr.OpenLinkTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconExport}" />
                                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Qr.OpenLink}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource FlatButton}" Click="OnCopy" ToolTip="{l:T Qr.CopyTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" />
                                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Qr.Copy}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Format}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <!-- The decoded data: read-only but selectable; left to right even in Arabic (URLs, numbers) -->
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                                             VerticalScrollBarVisibility="Auto" Padding="6,4" FontSize="13.5" FlowDirection="LeftToRight" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="MessageText" Margin="24" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="13.5" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</Window>
