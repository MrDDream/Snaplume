<Window x:Class="Snaplume.Editor.ResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Snaplume.Core"
        Title="{l:T Resize.Title}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="CurrentSizeText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

        <TextBlock Text="{l:T Resize.Percentage}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <WrapPanel x:Name="PercentButtons" Margin="0,0,0,14" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:T Resize.Width}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="WidthBox" Padding="6,4" TextChanged="OnWidthChanged" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="×" FontSize="18" VerticalAlignment="Bottom" Margin="10,0,10,3"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel Grid.Column="2">
                <TextBlock Text="{l:T Resize.Height}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="HeightBox" Padding="6,4" TextChanged="OnHeightChanged" />
            </StackPanel>
        </Grid>
        <CheckBox x:Name="KeepRatioCheck" Content="{l:T Resize.KeepRatio}" IsChecked="True" Margin="0,10,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
        <TextBlock Text="{l:T Resize.Note}"
                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11.5" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:T Resize.Ok}" IsDefault="True" Padding="14,4" Click="OnOk" />
            <Button Content="{l:T Resize.Cancel}" IsCancel="True" Padding="14,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
