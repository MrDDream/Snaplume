<Window x:Class="Snaplume.Ocr.OcrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Snaplume.Core"
        Title="{l:T Ocr.Title}" Width="640" Height="480" MinWidth="380" MinHeight="260"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PropertyLabel}" Text="{l:T Ocr.Language}" Margin="0,0,8,0" />
                    <ComboBox x:Name="LanguageBox" MinWidth="180" VerticalAlignment="Center"
                              DisplayMemberPath="DisplayName" SelectionChanged="OnLanguageChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Click="OnCopy" ToolTip="{l:T Ocr.CopyTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" Stroke="{DynamicResource OnAccentBrush}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Ocr.Copy}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="OnClose" Margin="8,0,0,0" IsCancel="True">
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Ocr.Close}" />
                    </Button>
                </StackPanel>
                <Button x:Name="LanguageSettingsButton" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                        Click="OnLanguageSettings" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="{l:T Ocr.OpenLanguageSettings}" Foreground="{DynamicResource AccentBrush}" />
                </Button>
            </DockPanel>
        </Border>

        <Grid>
            <TextBox x:Name="ResultBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="14,12" FontFamily="Segoe UI" FontSize="14" />
            <TextBlock x:Name="MessageText" Margin="24" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="13.5" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</Window>
