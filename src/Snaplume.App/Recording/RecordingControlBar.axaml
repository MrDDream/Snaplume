<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Snaplume.Ui"
        x:Class="Snaplume.Recording.RecordingControlBar"
        Title="{l:T Recording.Title}" WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        CanResize="False" SizeToContent="WidthAndHeight" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" FlowDirection="LeftToRight">
    <!--
      Dark in both themes, like the recording frame. Before the recording: the Record button and the options
      (sound, webcam, zoom on clicks, size of the area, settings), icons above their labels. During the recording:
      pause and stop. The templates name their presenter "Presenter": Fluent paints its own hover background behind
      a presenter named PART_ContentPresenter.
    -->
    <Window.Styles>
        <!-- Small square buttons of the title row (close) -->
        <Style Selector="Button.bar">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Options and recording buttons: an icon of about 28 px above its label -->
        <Style Selector=":is(Button).option">
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Padding" Value="6,4,6,3" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- The drop-down arrow next to an option: as high as the icon -->
        <Style Selector="Button.chevron">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="-2,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector=":is(Button).option:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
        <Style Selector=":is(Button).option:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="#4A4A4A" />
        </Style>
        <Style Selector="Button.bar:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
        <Style Selector="Button.bar:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="#4A4A4A" />
        </Style>
        <Style Selector=":is(Button).option:disabled, Button.bar:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector="Path.option-icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <!-- The 24x24 grid scaled to 28 px -->
            <Setter Property="RenderTransformOrigin" Value="0%,0%" />
            <Setter Property="RenderTransform" Value="scale(1.1667)" />
        </Style>
        <Style Selector="TextBlock.option-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <!-- An option that is off: dimmed, its icon struck through -->
        <Style Selector="ToggleButton.option Path.strike">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ToggleButton.option:unchecked Path.strike">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ToggleButton.option:unchecked Path.option-icon">
            <Setter Property="Stroke" Value="#9A9A9A" />
        </Style>
        <Style Selector="ToggleButton.option:unchecked TextBlock.option-label">
            <Setter Property="Foreground" Value="#9A9A9A" />
        </Style>

        <!-- The Record button: a red disc in a red ring -->
        <Style Selector="Button.record">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <Ellipse Name="Ring" Width="50" Height="50" Stroke="#E53935" StrokeThickness="2.5" />
                        <Ellipse Name="Disc" Width="36" Height="36" Fill="#E53935" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.record:pointerover /template/ Ellipse#Disc">
            <Setter Property="Fill" Value="#F05350" />
        </Style>
        <Style Selector="Button.record:pressed /template/ Ellipse#Disc">
            <Setter Property="Fill" Value="#C62828" />
        </Style>
        <Style Selector="Rectangle.bar-separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Fill" Value="#4B4B4B" />
        </Style>
    </Window.Styles>

    <Border Background="#F01F1F1F" BorderBrush="#4B4B4B" BorderThickness="1" CornerRadius="10" Padding="10,4,6,8"
            PointerPressed="OnDrag" ToolTip.Tip="{l:T Recording.DragTip}">
        <Grid RowDefinitions="Auto,Auto">
            <!-- Title, time and close -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                <TextBlock x:Name="TitleText" Grid.ColumnSpan="3" Text="{l:T Recording.BarTitle}" Foreground="#E0E0E0"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="70,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Ellipse x:Name="RecordDot" Width="8" Height="8" Fill="#E53935" VerticalAlignment="Center" Margin="0,0,5,0"
                             IsVisible="False" />
                    <TextBlock x:Name="TimeText" Text="0:00:00" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="2" Classes="bar" Click="OnCancel" ToolTip.Tip="{l:T Recording.CloseTip}">
                    <Path Classes="icon" Data="{StaticResource IconClose}" Stroke="White" Width="14" Height="14">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="0.58" ScaleY="0.58" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <!-- Before the recording -->
                <Button x:Name="RecordButton" Classes="record" Click="OnRecord" ToolTip.Tip="{l:T Recording.RecordTip}" />
                <StackPanel x:Name="OptionsPanel" Orientation="Horizontal">
                    <ToggleButton x:Name="MicrophoneToggle" Classes="option" IsCheckedChanged="OnOptionChanged"
                                  ToolTip.Tip="{l:T Recording.MicrophoneTip}">
                        <StackPanel>
                            <Panel HorizontalAlignment="Center">
                                <Path Classes="option-icon" Data="{StaticResource IconMicrophone}" />
                                <Path Classes="option-icon strike" Data="{StaticResource IconStrike}" />
                            </Panel>
                            <TextBlock Classes="option-label" Text="{l:T Recording.Microphone}" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="MicrophoneMenuButton" Classes="option chevron" Click="OnMicrophoneMenu"
                            ToolTip.Tip="{l:T Recording.MicrophoneChoiceTip}">
                        <Path Data="{StaticResource IconChevronDown}" Stroke="White" StrokeThickness="1.5" StrokeLineCap="Round"
                              StrokeJoin="Round" Width="9" Height="5" Margin="0,13,0,0" />
                    </Button>
                    <ToggleButton x:Name="SystemAudioToggle" Classes="option" IsCheckedChanged="OnOptionChanged"
                                  ToolTip.Tip="{l:T Recording.SystemAudioTip}">
                        <StackPanel>
                            <Panel HorizontalAlignment="Center">
                                <Path Classes="option-icon" Data="{StaticResource IconSpeaker}" />
                                <Path Classes="option-icon strike" Data="{StaticResource IconStrike}" />
                            </Panel>
                            <TextBlock Classes="option-label" Text="{l:T Recording.SystemAudio}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="WebcamToggle" Classes="option" IsCheckedChanged="OnOptionChanged"
                                  ToolTip.Tip="{l:T Recording.WebcamTip}">
                        <StackPanel>
                            <Panel HorizontalAlignment="Center">
                                <Path Classes="option-icon" Data="{StaticResource IconWebcam}" />
                                <Path Classes="option-icon strike" Data="{StaticResource IconStrike}" />
                            </Panel>
                            <TextBlock Classes="option-label" Text="{l:T Recording.Webcam}" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="WebcamMenuButton" Classes="option chevron" Click="OnWebcamMenu"
                            ToolTip.Tip="{l:T Recording.WebcamChoiceTip}">
                        <Path Data="{StaticResource IconChevronDown}" Stroke="White" StrokeThickness="1.5" StrokeLineCap="Round"
                              StrokeJoin="Round" Width="9" Height="5" Margin="0,13,0,0" />
                    </Button>
                    <ToggleButton x:Name="ZoomToggle" Classes="option" IsCheckedChanged="OnOptionChanged"
                                  ToolTip.Tip="{l:T Recording.ZoomTip}" ToolTip.ShowOnDisabled="True">
                        <StackPanel>
                            <Panel HorizontalAlignment="Center">
                                <Path Classes="option-icon" Data="{StaticResource IconZoomIn}" />
                                <Path Classes="option-icon strike" Data="{StaticResource IconStrike}" />
                            </Panel>
                            <TextBlock Classes="option-label" Text="{l:T Recording.Zoom}" />
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle x:Name="SizeSeparator" Classes="bar-separator" />
                    <Button x:Name="SizeButton" Classes="option" Click="OnSizeMenu" ToolTip.Tip="{l:T Recording.SizeTip}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Height="28" HorizontalAlignment="Center">
                                <TextBlock x:Name="SizeText" Text="1280 × 720" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Path Data="{StaticResource IconChevronDown}" Stroke="White" StrokeThickness="1.5" StrokeLineCap="Round"
                                      StrokeJoin="Round" Width="9" Height="5" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="option-label" Text="{l:T Recording.Size}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Classes="option" Click="OnSettings" ToolTip.Tip="{l:T Recording.SettingsTip}">
                        <StackPanel>
                            <Path Classes="option-icon" Data="{StaticResource IconSettings}" />
                            <TextBlock Classes="option-label" Text="{l:T Recording.Settings}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- During the countdown and the recording -->
                <StackPanel x:Name="RecordingButtons" Orientation="Horizontal" IsVisible="False">
                    <Button x:Name="PauseButton" Classes="option" Click="OnPause" ToolTip.Tip="{l:T Recording.Pause}" IsEnabled="False">
                        <StackPanel>
                            <Path x:Name="PauseIcon" Classes="option-icon" Fill="White" StrokeThickness="2.2" />
                            <TextBlock x:Name="PauseLabel" Classes="option-label" Text="{l:T Recording.Pause}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Classes="option" Click="OnStop" ToolTip.Tip="{l:T Recording.StopTip}">
                        <StackPanel>
                            <Panel Width="28" Height="28" HorizontalAlignment="Center">
                                <Rectangle Width="16" Height="16" RadiusX="2" RadiusY="2" Fill="#E53935" />
                            </Panel>
                            <TextBlock Classes="option-label" Text="{l:T Recording.Stop}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
