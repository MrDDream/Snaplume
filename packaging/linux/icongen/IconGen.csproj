<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders docs/branding/snaplume.svg to the hicolor PNG icons of the Linux packages (packaging/linux/icons) and
    to the tray icon embedded in Snaplume.Platform.Linux. Not part of Snaplume.slnx: run it by hand after
    changing the logo, then commit the PNGs:
      dotnet run (project packaging/linux/icongen)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

</Project>
