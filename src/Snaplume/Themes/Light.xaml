<!-- Light theme colors. Same keys as Dark.xaml; ThemeManager swaps the two, so use them with DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="RowLineBrush" Color="#EEF0F3" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#E8EAEE" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="TileBrush" Color="#E6E9EE" />

    <!-- Text and lines -->
    <SolidColorBrush x:Key="TextBrush" Color="#111827" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="IconBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="LineBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#C62828" />

    <!-- States -->
    <SolidColorBrush x:Key="HoverBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="PressedBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="CheckedBrush" Color="#EDE9FE" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E9EBEF" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#E3E6EB" />

    <!-- Accent: the violet of the logo -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6D28D9" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B21B6" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4C1D95" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnAccentLineBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="RecordBrush" Color="#E53935" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C4C9D2" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C1C6CE" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="SwitchTrackBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SwitchBorderBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="SwitchKnobBrush" Color="#4B5563" />

    <!-- Notices -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#F59E0B" />

    <!-- Quick panel -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelChromeBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="SecondaryActionBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#14000000" />
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#26000000" />

    <!-- Workspace list: an entry where dragged captures will be dropped -->
    <SolidColorBrush x:Key="DropTargetBrush" Color="#EDE9FE" />

    <!-- Editor color swatches -->
    <SolidColorBrush x:Key="SwatchOutlineBrush" Color="#9CA3AF" />

    <!-- Capture gallery -->
    <SolidColorBrush x:Key="GalleryBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="GalleryTextBrush" Color="#111827" />
    <SolidColorBrush x:Key="GalleryMutedTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="GalleryHoverBrush" Color="#EEF0F4" />
    <SolidColorBrush x:Key="GallerySelectedBrush" Color="#EDE9FE" />
    <SolidColorBrush x:Key="GallerySelectedBorderBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="GalleryThumbnailBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="GalleryThumbnailBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="GalleryBadgeBrush" Color="#B0000000" />
    <SolidColorBrush x:Key="GalleryBadgeIconBrush" Color="#FFFFFF" />

    <!-- Video player: stays dark in both themes, like a cinema screen (mpv style) -->
    <SolidColorBrush x:Key="PlayerBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="PlayerTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PlayerHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="PlayerTrackBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="PlayerAccentBrush" Color="#E53935" />
    <SolidColorBrush x:Key="PlayerOsdBrush" Color="#A0000000" />
    <LinearGradientBrush x:Key="PlayerControllerBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#D0000000" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
