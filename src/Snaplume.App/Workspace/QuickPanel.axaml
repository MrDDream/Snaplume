<!-- Compact panel near the notification area: recent captures and the main actions, opened from the tray icon. -->
<local:CaptureHostWindow xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:l="using:Snaplume.Ui"
                         xmlns:local="using:Snaplume.Workspace"
                         x:Class="Snaplume.Workspace.QuickPanel"
                         Title="Snaplume" Width="760" Height="480" MinWidth="560" MinHeight="320"
                         Icon="/Assets/app.ico"
                         WindowDecorations="None" CanResize="True" WindowStartupLocation="Manual"
                         UseLayoutRounding="True" Background="{DynamicResource PanelBrush}">
    <Window.Resources>
        <!-- Smaller gallery items than in the workspace -->
        <x:Double x:Key="GalleryItemWidth">150</x:Double>
        <x:Double x:Key="GalleryThumbnailHeight">96</x:Double>
        <TextAlignment x:Key="GalleryTextAlignment">Center</TextAlignment>
    </Window.Resources>

    <Window.Styles>
        <!-- Buttons of the title bar -->
        <Style Selector="Button.title">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="Path.chevron">
            <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Workspace button of the title bar: current workspace name; shows or hides the side panel of the workspaces -->
        <Style Selector="ToggleButton.workspace">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0,10,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <!-- In the Tab order, unlike the other buttons of the title bar: the panel opens from the keyboard too -->
            <Setter Property="Focusable" Value="True" />
        </Style>
        <Style Selector="ToggleButton.workspace:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <!-- Open: the selected look of the workspace list, not Fluent's accent fill -->
        <Style Selector="ToggleButton.workspace:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="ToggleButton.workspace:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
        </Style>

        <!-- Side panel of the workspaces: its width slides; the content keeps its own width meanwhile -->
        <Style Selector="Border#WorkspacePane">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!--
          Split button: main action and its menu, drawn as one pill: rounded on the start side for the action,
          on the end side for the menu arrow. The background (accent or secondary) is set on each button; the
          pointer darkens or lightens it with an overlay.
        -->
        <Style Selector="Button.split">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="19,0,0,19" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <Border Name="Shade" Background="{DynamicResource OverlayBrush}" Opacity="0"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                            <!-- Not named PART_ContentPresenter: Fluent would paint its hover background behind the label. -->
                            <ContentPresenter Name="SplitContent" Content="{TemplateBinding Content}"
                                              Margin="14,0,12,0" VerticalAlignment="Center" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.split.arrow">
            <Setter Property="CornerRadius" Value="0,19,19,0" />
        </Style>
        <Style Selector="Button.split.arrow /template/ ContentPresenter#SplitContent">
            <Setter Property="Margin" Value="10,0,12,0" />
        </Style>
        <Style Selector="Button.split:pointerover /template/ Border#Shade">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.split:pressed /template/ Border#Shade">
            <Setter Property="Background" Value="{DynamicResource OverlayPressedBrush}" />
        </Style>

        <!-- Action on the selected captures: icon above its label (in the Tag) -->
        <Style Selector="Button.selection-action">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="Transparent" CornerRadius="8">
                        <StackPanel VerticalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.selection-action:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.selection-action:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
        </Style>
        <Style Selector="Button.selection-action:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Title bar (dragged to move the panel) -->
            <DockPanel Name="TitleBar" DockPanel.Dock="Top" Background="{DynamicResource PanelChromeBrush}" Height="38">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Classes="flat title" Click="OnOpenFolder" ToolTip.Tip="{l:T Panel.OpenFolderTip}">
                        <Path Classes="icon" Data="{StaticResource IconFolder}" />
                    </Button>
                    <Button Classes="flat title" Click="OnSettings" ToolTip.Tip="{l:T Panel.SettingsTip}">
                        <Path Classes="icon" Data="{StaticResource IconSettings}" />
                    </Button>
                    <Button Classes="flat title" Click="OnOpenWorkspace" ToolTip.Tip="{l:T Panel.OpenWorkspaceTip}">
                        <Path Classes="icon" Data="{StaticResource IconExpand}" />
                    </Button>
                    <Button Classes="flat title" Click="OnHide" ToolTip.Tip="{l:T Panel.HideTip}">
                        <Path Classes="icon" Data="{StaticResource IconClose}" />
                    </Button>
                </StackPanel>
                <Image DockPanel.Dock="Left" Source="{StaticResource LogoImage}" Width="20" Height="20" Margin="12,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="Snaplume" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                <ToggleButton Name="WorkspaceButton" DockPanel.Dock="Left" Classes="flat workspace" Margin="12,0,0,0"
                              ToolTip.Tip="{l:T Panel.WorkspaceTip}" AutomationProperties.Name="{l:T Panel.WorkspaceTip}"
                              IsCheckedChanged="OnWorkspaceButtonChecked">
                    <StackPanel Orientation="Horizontal">
                        <Path Classes="icon" Data="{StaticResource IconWorkspace}" Width="16.8" Height="16.8" RenderTransform="scale(0.7)" />
                        <TextBlock Name="WorkspaceName" Margin="6,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <TextBlock Name="SummaryText" Foreground="{DynamicResource MutedTextBrush}" Margin="12,1,8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Action bar -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelChromeBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0" Padding="14,10,10,10">
                <DockPanel>
                    <!-- Resize grip (the panel has no system frame) -->
                    <Border Name="ResizeGrip" DockPanel.Dock="Right" Width="12" Height="12" Margin="4,0,-6,-6" VerticalAlignment="Bottom"
                            Background="Transparent" Cursor="BottomRightCorner">
                        <Path Data="M11,1 L1,11 M11,5 L5,11 M11,9 L9,11" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1" />
                    </Border>

                    <!-- Actions on the selection -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="EditButton" Classes="selection-action" Tag="{l:T Panel.Edit}" Click="OnEdit" ToolTip.Tip="{l:T Panel.EditTip}">
                            <Path Classes="icon" Data="{StaticResource IconEdit}" />
                        </Button>
                        <Button Name="ReadTextButton" Classes="selection-action" Tag="{l:T Ocr.ReadTextShort}" Click="OnReadText" ToolTip.Tip="{l:T Ocr.ReadTextTip}">
                            <Path Classes="icon" Data="{StaticResource IconOcr}" />
                        </Button>
                        <Button Name="ReadQrButton" Classes="selection-action" Tag="{l:T Panel.Qr}" Click="OnReadQrOfSelection" ToolTip.Tip="{l:T Panel.QrTip}">
                            <Path Classes="icon" Data="{StaticResource IconQr}" />
                        </Button>
                        <Button Name="CopyButton" Classes="selection-action" Tag="{l:T Panel.Copy}" Click="OnCopy" ToolTip.Tip="{l:T Panel.CopyTip}">
                            <Path Classes="icon" Data="{StaticResource IconCopy}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Capture: the main action, in the accent color -->
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="split" Background="{DynamicResource AccentBrush}" Click="OnCaptureRegion"
                                    ToolTip.Tip="{l:T Panel.CaptureRegionTip}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Classes="icon" Data="{StaticResource IconCamera}" Stroke="{DynamicResource OnAccentBrush}" />
                                    <TextBlock Text="{l:T Panel.CaptureRegion}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold"
                                               Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Rectangle Width="1" Fill="{DynamicResource OnAccentLineBrush}" Height="38" />
                            <Button Name="CaptureMenuButton" Classes="split arrow" Background="{DynamicResource AccentBrush}"
                                    ToolTip.Tip="{l:T Panel.MoreCapturesTip}">
                                <Path Classes="chevron" Stroke="{DynamicResource OnAccentBrush}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                                        <MenuItem Header="{l:T Panel.Menu.CaptureScreen}" Click="OnCaptureScreen" />
                                        <MenuItem Header="{l:T Panel.Menu.CaptureAllScreens}" Click="OnCaptureAllScreens" />
                                        <MenuItem Header="{l:T Panel.Menu.RepeatLast}" Click="OnCaptureRepeat" />
                                        <MenuItem Name="ScrollingMenuItem" Header="{l:T Panel.Menu.CaptureScrolling}" Click="OnCaptureScrolling" />
                                        <MenuItem Header="{l:T Ocr.CaptureText}" Click="OnCaptureText" />
                                        <MenuItem Header="{l:T Panel.Menu.ReadQr}" Click="OnReadQr" />
                                        <Separator />
                                        <MenuItem Header="{l:T Panel.Menu.Delay3}" Tag="3" Click="OnDelayedCapture" />
                                        <MenuItem Header="{l:T Panel.Menu.Delay5}" Tag="5" Click="OnDelayedCapture" />
                                        <MenuItem Header="{l:T Panel.Menu.Delay10}" Tag="10" Click="OnDelayedCapture" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!-- Video: secondary, with the red "record" dot (a square while recording: stop) -->
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Name="VideoButton" Classes="split" Background="{DynamicResource SecondaryActionBrush}"
                                    Click="OnRecordVideo" ToolTip.Tip="{l:T Panel.RecordVideoTip}">
                                <StackPanel Orientation="Horizontal">
                                    <Panel Width="11" Height="11" VerticalAlignment="Center" Margin="2,0,1,0">
                                        <Ellipse Name="RecordDot" Fill="{DynamicResource RecordBrush}" />
                                        <Rectangle Name="StopSquare" Fill="{DynamicResource RecordBrush}" RadiusX="1.5" RadiusY="1.5" IsVisible="False" />
                                    </Panel>
                                    <TextBlock Name="VideoButtonText" Text="{l:T Panel.RecordVideo}" FontWeight="SemiBold" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Height="38" />
                            <Button Name="VideoMenuButton" Classes="split arrow" Background="{DynamicResource SecondaryActionBrush}"
                                    ToolTip.Tip="{l:T Panel.MoreRecordingsTip}">
                                <Path Classes="chevron" Stroke="{DynamicResource IconBrush}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                                        <MenuItem Header="{l:T Panel.Menu.RecordScreen}" Click="OnRecordScreen" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Side panel of the workspaces (start side), opened with the workspace button: the gallery shrinks -->
            <Border Name="WorkspacePane" DockPanel.Dock="Left" Width="0" IsVisible="False" ClipToBounds="True"
                    Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Width="{x:Static local:QuickPanel.WorkspacePaneWidth}" HorizontalAlignment="Left">
                    <TextBlock DockPanel.Dock="Top" Text="{l:T Workspaces.Header}" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold"
                               Margin="18,12,12,6" />
                    <Button Name="NewWorkspaceButton" DockPanel.Dock="Bottom" Classes="flat" Margin="8,6,8,8" Padding="8,6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True" Click="OnNewWorkspace"
                            ToolTip.Tip="{l:T Workspaces.NewTipFolder}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource IconAdd}" />
                            <TextBlock Classes="button-label" Text="{l:T Workspaces.New}" Margin="6,0,2,0" />
                        </StackPanel>
                    </Button>
                    <local:WorkspaceList Name="WorkspaceList" />
                </DockPanel>
            </Border>

            <local:CaptureGallery Name="Gallery" />
        </DockPanel>
    </Border>
</local:CaptureHostWindow>
