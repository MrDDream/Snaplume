<Window x:Class="Snaplume.Recording.RecordingControlBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Snaplume.Core"
        Title="{l:T Recording.Title}" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="PauseGeometry">M9,6 V18 M15,6 V18</Geometry>
        <Geometry x:Key="ResumeGeometry">M8,5.5 L18.5,12 L8,18.5 Z</Geometry>
    </Window.Resources>

    <Border Background="#F01F1F1F" BorderBrush="#4B4B4B" BorderThickness="1" CornerRadius="10" Padding="10,5"
            MouseLeftButtonDown="OnDrag" ToolTip="{l:T Recording.DragTip}">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="RecordDot" Width="12" Height="12" Fill="#E53935" VerticalAlignment="Center" />
            <TextBlock x:Name="TimeText" Text="00:00" Foreground="White" FontSize="16" FontWeight="SemiBold"
                       MinWidth="120" Margin="8,0,10,0" VerticalAlignment="Center" />
            <Button x:Name="PauseButton" Style="{StaticResource BarButton}" Click="OnPause" ToolTip="{l:T Recording.Pause}" IsEnabled="False">
                <Path x:Name="PauseIcon" Data="{StaticResource PauseGeometry}" Stroke="White" Fill="White" StrokeThickness="2.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24" Stretch="None"
                      FlowDirection="LeftToRight">
                    <Path.LayoutTransform>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                    </Path.LayoutTransform>
                </Path>
            </Button>
            <Button x:Name="StopButton" Style="{StaticResource BarButton}" Click="OnStop" ToolTip="{l:T Recording.StopTip}">
                <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2" Fill="#E53935" />
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource BarButton}" Click="OnCancel" ToolTip="{l:T Recording.CancelTip}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" Stroke="White" />
            </Button>
        </StackPanel>
    </Border>
</Window>
